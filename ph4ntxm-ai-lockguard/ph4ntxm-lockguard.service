[Unit]
Description=PH4NTXM AI LockGuard
After=graphical-session.target

[Service]
Type=simple
ExecStart=%INSTALL_DIR%/.venv/bin/python %INSTALL_DIR%/ph4ntxm_lockguard.py \
    --model %INSTALL_DIR%/face_detector.task \
    --panic-script %INSTALL_DIR%/panic.sh
Restart=on-failure
RestartSec=5
MemoryMax=150M
Nice=10

[Install]
WantedBy=default.target